# Example environment variables for Supraserver (do NOT commit secrets)
# PostgreSQL (Supabase) connection
DB_HOST=your-supabase-db-host.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_super_secret_password

# Optional: adjust if your app uses other envs
# APP_ENV=production
# APP_DEBUG=false
